# tio configuration for the ASCEND bench (macOS).
#
# Install with:
#     ln -sf "$PWD/scripts/tio-config" ~/.config/tio/config
#
# No board profiles here on purpose. Both boards print their own name at the
# start of every line ("PNC " / "Payload "), so every logger appends to the one
# log file and attribution comes from the line, not from the file name. See
# `uv run scripts/tio_serial.py start`, which passes --log-file explicitly.

[default]
baudrate = 115200
databits = 8
parity = none
stopbits = 1
flow = none

# Prefix every line with an ISO 8601 timestamp so logs can be grepped by time.
timestamp = true
timestamp-format = iso8601
timestamp-timeout = 200

# tio puts the terminal in raw mode (OPOST off), so a bare LF from the board
# does not return the cursor to column 0 and long binary lines stair-step
# across the pane. Mapping LF to CR-LF keeps every line starting at the left
# edge; PnC's existing CR-LF becomes CR-CR-LF, which renders the same.
map = INLCRNL

# Log everything. The logger overrides log-file with logs/ascend.log.
log = true
log-directory = /Users/pranav/ASU/ASCEND/Fall-2026/logs
log-append = true
log-strip = true

color = bold
alert = none

